{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/ahmadmarafa/laravel-sendgrid-notification-channel"
        }
    ],
    "require": {
        "php": "^8.2",
        "astrotomic/laravel-translatable": "^11.11",
        "kalnoy/nestedset": "^6.1",
        "laravel-notification-channels/fcm": "^6.0",
        "laravel/framework": "^12.0",
        "laravel/passport": "^13.0",
        "laravel/tinker": "^2.9",
        "maatwebsite/excel": "^3.1",
        "sendgrid/sendgrid": "^8.1",
        "tightenco/ziggy": "^2.0",
        "vonage/client": "^4.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.13",
        "fakerphp/faker": "^1.23",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.1",
        "phpunit/phpunit": "^11.0"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "funkjedi/composer-include-files": true,
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.3.0",
            "ext-gmp": "8.3.0"
        },
        "audit": {
            "ignore": [
                "PKSA-2kqm-ps5x-s4f5"
            ]
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        },
        "include_files": [
            "app/Http/Helpers.php"
        ]
    },
    "autoload": {
        "files": [
            "app/Http/Helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}